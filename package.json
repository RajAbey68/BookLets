{
  "name": "booklets",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:integration:setup": "bash scripts/test-integration-setup.sh",
    "test:integration": "npm run test:integration:setup && DATABASE_URL=postgresql://postgres:test@localhost:55432/booklets_test vitest run --config vitest.integration.config.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:setup": "prisma db push && prisma db seed",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "e2e": "node scripts/e2e/run.mjs",
    "e2e:quick": "node scripts/e2e/run.mjs --quick",
    "e2e:make-export": "node scripts/e2e/whatsapp-export.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "adm-zip": "^0.6.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "pg": "^8.23.0",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "@hono/node-server": "^1.19.13"
  }
}
